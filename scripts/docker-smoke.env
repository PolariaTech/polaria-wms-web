# Variables FALSAS de runtime para la prueba de humo de la imagen (scripts/docker-smoke.sh).
# Ningún valor es real: solo evitan que el servidor falle al arrancar por falta de variables.
# Las NEXT_PUBLIC_* no van aquí: se fijan al construir la imagen (--build-arg).
OPENAI_API_KEY=smoke-not-a-real-key
SUPABASE_SERVICE_ROLE_KEY=smoke-not-a-real-key
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=smoke
SMTP_PASS=smoke
SMTP_FROM=smoke@example.invalid
CLOUDINARY_URL=cloudinary://smoke:smoke@smoke
EMBED_REPORT_SIGNING_SECRET=smoke-not-a-real-secret
